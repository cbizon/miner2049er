{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renci.org/miner2049er/schemas/evaluation.schema.json",
  "title": "Aggregate rule evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "split_id",
    "run_id",
    "round_id",
    "rule_id",
    "partition",
    "prediction_sha256",
    "counts",
    "metrics",
    "scored_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string"},
    "split_id": {"type": "string"},
    "run_id": {"type": "string"},
    "round_id": {"type": "string", "pattern": "^round-[0-9]{4}$"},
    "rule_id": {"type": "string"},
    "partition": {"enum": ["feedback", "final"]},
    "prediction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_predictions",
        "eligible_predictions",
        "known_hits",
        "partition_labels"
      ],
      "properties": {
        "submitted_predictions": {"type": "integer", "minimum": 0},
        "eligible_predictions": {"type": "integer", "minimum": 0},
        "known_hits": {"type": "integer", "minimum": 0},
        "partition_labels": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision_lower_bound", "recall", "f0_5"],
      "properties": {
        "precision_lower_bound": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f0_5": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "scored_at": {"type": "string", "format": "date-time"}
  }
}
