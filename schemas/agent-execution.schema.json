{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renci.org/miner2049er/schemas/agent-execution.schema.json",
  "title": "Rule-mining agent execution settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "round_id",
    "model",
    "model_provider",
    "reasoning_effort"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "round_id": {"type": "string", "pattern": "^round-[0-9]{4}$"},
    "model": {"type": "string", "minLength": 1},
    "model_provider": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1}
  }
}
