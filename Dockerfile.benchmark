FROM node:22-bookworm-slim AS node-runtime

FROM python:3.12-slim

# Claude Code for the in-cluster agent (miner-run-agent run --isolation container).
COPY --from=node-runtime /usr/local /usr/local
ARG CLAUDE_CODE_VERSION=2.1.310
RUN npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app
RUN python -m pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY schemas ./schemas
COPY config ./config
COPY prompts ./prompts
COPY cypher ./cypher
COPY data/reference/biolink/4.4.4 ./data/reference/biolink/4.4.4
RUN uv sync --frozen --no-dev

CMD ["uvicorn", "miner2049er.dashboard_server:APP", "--host", "0.0.0.0", "--port", "6431"]
